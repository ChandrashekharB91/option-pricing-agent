# Copy this file to .env (same folder) and fill in what you use.
# .env is git-ignored; never commit it or paste keys into chats or tickets.

# ---- Market data ------------------------------------------------------------
# Upstox read-only Analytics Token (live market data)
UPSTOX_ANALYTICS_TOKEN=
# replay = the recorded 23 Oct 2026 NIFTY snapshot (works offline, any time); live = Upstox + FBIL
DATA_MODE=replay

# ---- LLM for the agents (placeholder: plug in any provider) -----------------
# LLM_PROVIDER: anthropic | openai | groq | gemini | openrouter | github | cerebras | mistral | ollama | custom
LLM_PROVIDER=
LLM_API_KEY=
# Model id at that provider. Defaults exist for groq (openai/gpt-oss-120b), gemini (gemini-3.8-flash)
# and anthropic (claude-sonnet-5-5); set it for the others.
LLM_MODEL=
# Only for LLM_PROVIDER=custom, or to override a preset (any OpenAI-compatible /v1 URL)
LLM_BASE_URL=
# Optional: a different model for the independent validator agent
VALIDATOR_MODEL=

# Examples (uncomment one block):
# LLM_PROVIDER=groq          # free tier, fast; key from console.groq.com
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b
#
# LLM_PROVIDER=gemini        # free tier; key from aistudio.google.com (free-tier prompts may be used by Google)
# LLM_API_KEY=...
# LLM_MODEL=gemini-3.8-flash
#
# LLM_PROVIDER=ollama        # local, free, data stays on the machine; install from ollama.com
# LLM_MODEL=qwen3            # any locally pulled model with tool support

# ---- Dashboard ----------------------------------------------------------------
# PRICING_API_URL=http://127.0.0.1:8000
