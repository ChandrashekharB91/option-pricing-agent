# Copy this file to .env (same folder) and fill in what you use.
# .env is git-ignored; never commit it or paste keys into chats or tickets.

# Upstox read-only Analytics Token (live market data)
UPSTOX_ANALYTICS_TOKEN=

# Anthropic API key (orchestrator and validator agents)
ANTHROPIC_API_KEY=

# replay = the recorded 23 Oct 2026 NIFTY snapshot (works offline, any time); live = Upstox + FBIL
DATA_MODE=replay

# Optional overrides
# ORCHESTRATOR_MODEL=claude-sonnet-5-5
# VALIDATOR_MODEL=claude-sonnet-5-5
# PRICING_API_URL=http://127.0.0.1:8000
